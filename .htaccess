# ============================================================
# Conecta Vagas DF — regras do Apache (pasta raiz do projeto)
# ============================================================
Options -Indexes
DirectoryIndex index.php

# Todas as requisições vão para public/ — lá ficam os arquivos do navegador
# (CSS, JS, imagens) e o front controller (public/index.php). O endereço no
# navegador não muda: /vagas.php continua sendo /vagas.php.
# Com isso, app/, config/, database/, storage/... nunca são servidos.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Segurança extra (caso o mod_rewrite esteja desligado): scripts do banco,
# documentação, registros e arquivos ocultos nunca são baixados.
<FilesMatch "\.(sql|txt|md|log|ini|bak|env)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
